# Shared by the original runner and the Harbor adapter
TASK_ROOT=tasks
OUTPUT_ROOT=.
DOCKER_REGISTRY=docker.io
# Public release layout: one Docker Hub repository, one tag per task.
DOCKER_REPOSITORY=honglifish/csbench
# Leave DOCKER_REPOSITORY empty to use the historical
# <registry>/<namespace>/<task>:<tag> layout instead.
DOCKER_NAMESPACE=honglifish/csbench
DOCKER_TAG=latest
PROVIDER=openai
API_MODE=chat
API_BASE=https://api.example.com/v1
API_KEY=
API_MODEL=gpt-5.2
MAX_TURNS=50
API_TIMEOUT=180

# Harbor paths and scheduling (relative paths are resolved from this repository)
CSBENCH_DATASET_DIR=dataset/csbench
CSBENCH_JOBS_DIR=jobs
CSBENCH_CONCURRENCY=4
CSBENCH_TEMPERATURE=1.0
MODEL_MAX_TOKENS=32768
CSBENCH_LLM_TIMEOUT=180

# Optional aliases used by some Harbor/model integrations. When omitted, the
# CSBench adapter falls back to API_KEY, API_BASE, and API_MODEL above.
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Optional network proxy. scripts/run_harbor.sh forwards populated proxy
# variables into Harbor's agent setup and run phases with --agent-env.
# HTTP_PROXY=
# HTTPS_PROXY=
